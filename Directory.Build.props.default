<?xml version="1.0" encoding="utf-8"?>
<!--
	Instead of modifying this file, create a copy named Directory.Build.props.user and set the
	two paths below to match your own installation. Directory.Build.props.user is gitignored.

	=== GameLibsFolder ===
	The game's "OxygenNotIncluded_Data/Managed" folder (contains Assembly-CSharp.dll).
	In Steam: right-click Oxygen Not Included -> Manage -> Browse local files, then open
	OxygenNotIncluded_Data\Managed. Common locations:
		C:\Program Files (x86)\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed
		D:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed
		<any Steam library>\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed
	macOS: ~/Library/Application Support/Steam/steamapps/common/OxygenNotIncluded/OxygenNotIncluded.app/Contents/Resources/Data/Managed
	Linux:  ~/.steam/steam/steamapps/common/OxygenNotIncluded/OxygenNotIncluded_Data/Managed

	=== ModFolder ===
	Your local "mods/dev" folder — a Debug build copies the mod here so the game loads it.
	Common locations:
		%USERPROFILE%\Documents\Klei\OxygenNotIncluded\mods\dev
		%USERPROFILE%\OneDrive\Documents\Klei\OxygenNotIncluded\mods\dev   (if Documents is redirected to OneDrive)
	macOS:  ~/Library/Application Support/unity.Klei.Oxygen Not Included/mods/dev
	Linux:  ~/.config/unity3d/Klei/Oxygen Not Included/mods/dev
	Create the "dev" subfolder if it does not exist.
-->
<Project>
	<PropertyGroup>
		<!--Gamedata Folder, adjust to your own ONI installation-->
		<GameLibsFolder>X:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameLibsFolder>
		<GameLibsFolder Condition="!Exists('$(GameLibsFolder)')" >/mnt/Intel_Pestflatte/SteamLibrary/steamapps/common/OxygenNotIncluded/OxygenNotIncluded_Data/Managed</GameLibsFolder>

		<!--OutputModFolder, adjust it to your own dev folder-->
		<ModFolder>E:\Documents\Klei\OxygenNotIncluded\mods\dev</ModFolder>
		<ModFolder Condition="!Exists('$(GameLibsFolder)')">/mnt/Intel_Pestflatte/Klei/OxygenNotIncluded/mods/dev</ModFolder>
		<!--Default for dev folder: -->
		<!--<ModFolder>$(UserProfile)\Documents\Klei\OxygenNotIncluded\mods\dev</ModFolder>-->

		<!--Used to generate reference assemblies for GitHub CI; set this to 0 if you don't use automatic github builds and/or don't want to install Refasmer-->
		<RefasmerInstalled>1</RefasmerInstalled>
	</PropertyGroup>
</Project>
