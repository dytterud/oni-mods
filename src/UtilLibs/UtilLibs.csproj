<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Configurations>Debug;Release;Release2</Configurations>
		<DoNotBuildAsMod>true</DoNotBuildAsMod>
		<!--<DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>-->
	</PropertyGroup>
	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<!-- Vendored as-is: relies on UnityEngine.Object/Random being unambiguous,
		     and predates the nullable migration. Opted out like ImplicitUsings. -->
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Properties\**" />
	  <EmbeddedResource Remove="Properties\**" />
	  <None Remove="Properties\**" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="PLib" />
	</ItemGroup>
	<ItemGroup>
		<!-- IO_Utils' clipboard (GUIUtility.systemCopyBuffer). lib/ carries a refasm of it for
		     offline builds, generated like the rest of lib/ (refasmer with its "all" option). -->
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(GameLibsFolder)/UnityEngine.IMGUIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	<!--<ItemGroup>
		<Reference Include="$(GameLibsFolder)/netstandard.dll" Private ="false"/>
		<Reference Include="$(GameLibsFolder)/mscorlib.dll" Private ="false"/>
		<Reference Include="$(GameLibsFolder)/System.Data.dll" Private ="false"/>
	</ItemGroup>-->
</Project>
