<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
	  The three Generate* targets below deliberately do NOT register their outputs as
	  <FileWrites>. Doing so made `dotnet test` delete them.

	  The mod project is built twice with different global properties: as a mod, and again via
	  BlueprintsIncluded.Tests' ProjectReference with DoNotBuildAsMod=true. Different global
	  properties mean a separate MSBuild project instance, and the two used to share one
	  bin/$(Configuration)/$(TargetFramework). The test-flavoured instance skips these targets by
	  condition, so with FileWrites registered its IncrementalClean saw mod.yaml / mod_info.yaml /
	  LauncherMetadata.json as orphaned prior outputs and removed them.

	  A whole-solution build (test/run-ingame.ps1 builds the slnx) runs both instances, so
	  CopyModsToDevFolder below would then fail with MSB3030 on the missing files - and whether it
	  did came down to which instance MSBuild finished last. `dotnet clean` first only changed
	  that ordering luck.

	  Without the registrations these files are never in the prior-writes list, so nothing claims
	  them. The cost is that `dotnet clean` no longer deletes them individually; removing
	  bin/ still does.

	  The shared output directory that caused all of this is gone: the two flavours now build to
	  separate bin/ and obj/ (see the BaseOutputPath comment in Directory.Build.props), so the
	  test-flavoured instance can no longer see these files at all. Restoring the <FileWrites>
	  registrations is therefore probably safe now - but "probably" is not worth a silent
	  `dotnet test` regression, so it stays as it is until someone tests it deliberately.
	-->
	<!--Write mod.yaml file-->
	<Target Name="GenerateModYaml" BeforeTargets="PrepareForRun" Condition="'$(DoNotBuildAsMod)' != 'true'">
		<ItemGroup>
			<ModLines Include="title: '$(ModName)'"/>
			<ModLines Include="description: &quot;$([System.String]::Copy('$(ModDescription)').Replace('&quot;', '\&quot;'))&quot;"/>
			<ModLines Include="staticID: $(AssemblyName)"/>
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)/mod.yaml" Overwrite="true" Lines="@(ModLines)"/>
	</Target>
	<!--Write mod_info.yaml file-->
	<Target Name="GenerateModInfoYaml" BeforeTargets="PrepareForRun" Condition="'$(DoNotBuildAsMod)' != 'true'">
		<ItemGroup>
			<ModInfoLines Include="minimumSupportedBuild: $(TargetGameVersion)"/>
			<ModInfoLines Include="version: $(Version)"/>
			<ModInfoLines Include="APIVersion: 2"/>
			<!--Without this ONI can treat a mod as base-game-only and warn DLC players it is
			    incompatible. requiredDlcIds / forbiddenDlcIds stay unset: those are for mods that
			    only work *with* or *without* a DLC, which is a different claim.-->
			<ModInfoLines Include="supportedContent: $(SupportedContent)" Condition="'$(SupportedContent)' != ''"/>
			<ModInfoLines Include="requiredDlcIds:" Condition="'$(RequiredDlcIds)' != ''"/>
			<ModInfoLines Include="$([System.String]::Copy('$(RequiredDlcIds)').Insert(0,' - ').Replace(',','%0a- '))" Condition="'$(RequiredDlcIds)' != ''"/>
			<ModInfoLines Include="forbiddenDlcIds:" Condition="'$(ForbiddenDlcIds)' != ''"/>
			<ModInfoLines Include="$([System.String]::Copy('$(ForbiddenDlcIds)').Insert(0,' - ').Replace(',','%0a- '))" Condition="'$(ForbiddenDlcIds)' != ''"/>
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)/mod_info.yaml" Overwrite="true" Lines="@(ModInfoLines)"/>
	</Target>
	<!--Write LauncherMetadata.json file for Romen ModLauncher and SgtsModUpdater-->
	<Target Name="GenerateLauncherMetadata" BeforeTargets="PrepareForRun" Condition="'$(DoNotBuildAsMod)' != 'true'">
		<ItemGroup>
			<LauncherMetadataLines Include='{'/>
			<LauncherMetadataLines Include='"BugReportURL":"$(RepoUrl)/issues/new",'/>
			<LauncherMetadataLines Include='"RepoURL":"$(RepoUrl)",'/>
			<LauncherMetadataLines Include='"Author":"$(Authors)"'/>
			<LauncherMetadataLines Include='}'/>
		</ItemGroup>
		<WriteLinesToFile File="$(TargetDir)/LauncherMetadata.json" Overwrite="true" Lines="@(LauncherMetadataLines)"/>
	</Target>

	<!--Merges all dlls in the output folder into a single dll-->
	<Target Name="ILRepack" AfterTargets="Build" Condition="'$(IsPacked)' == 'true'">
		<ItemGroup>
			<InputAssemblies Include="$(TargetPath)" />
			<InputAssemblies
					Include="$(TargetDir)\*.dll"
					Exclude="$(TargetPath); **/0Harmony.dll; **_public.dll ;**Newtonsoft.Json;**/System.*; **/Microsoft.*; **/Unity*" />
		</ItemGroup>

		<ILRepack
		  TargetKind="SameAsPrimaryAssembly"
		  InputAssemblies="@(InputAssemblies)"
		  Wildcards="true"
		  LibraryPath="$(GameLibsFolder)"
		  OutputFile="$(TargetPath)"/>
	</Target>

	<PropertyGroup>
		<!--Offline build -> drop the packed mod into ./Builds; real-game build -> the ONI dev mods folder-->
		<TargetFolder Condition="'$(OfflineBuild)' != 'true'">$(ModFolder)\$(TargetName)_dev\</TargetFolder>
		<TargetFolder Condition="'$(OfflineBuild)' == 'true'">$(MSBuildThisFileDirectory)Builds\$(TargetName)</TargetFolder>
	</PropertyGroup>

	<!--Copies the mod dll, the yaml files and everything inside the ModAssets folder to the target mod folder-->
	<!--
	  DependsOnTargets on the three generators, not just BeforeTargets="PrepareForRun" on them:
	  this target copies those files, so it has to guarantee they exist rather than assume an
	  earlier phase produced them. When the compile is up to date, PrepareForRun's hooks do not
	  re-emit missing metadata, but this target still runs - so a build whose outputs were partly
	  removed (a clean that spared the assembly, an IncrementalClean from a differently-flavoured
	  build) failed with MSB3030 while reporting the project as up to date. Regenerating three
	  small text files is far cheaper than that failure mode. The generators are idempotent
	  (WriteLinesToFile Overwrite="true"), so running them twice in one build is harmless.
	-->
	<Target Name="CopyModsToDevFolder" AfterTargets="ILRepack" Condition="'$(DoNotBuildAsMod)' != 'true'"
	        DependsOnTargets="GenerateModYaml;GenerateModInfoYaml;GenerateLauncherMetadata">

		<Message Text="Executing CopyDLLs task" Importance="High" />
		<ItemGroup>
			<IgnorableAssets Include=".\**\*.afphoto;.\**\*.mo;.\**\*.afphoto~lock~;.\**\*.pdn;.\**\.gitkeep" />
		</ItemGroup>
		<ItemGroup>
			<ModAssets
				Include = ".\ModAssets\**\*.*"
				Exclude="@(IgnorableAssets)"
				/>
		</ItemGroup>

		<Copy
		  SourceFiles="
			$(TargetDir)$(TargetName).dll;
			$(TargetDir)$(TargetName).pdb;
			$(TargetDir)mod.yaml;
			$(TargetDir)mod_info.yaml;
			$(TargetDir)LauncherMetadata.json;
		  "
		  DestinationFolder="$(TargetFolder)"/>

		<!--MIT requires the copyright notice to travel with distributed copies, and a Workshop
		    upload is a distribution - so the packaged folder carries them, not just the repo.
		    NOTICE is the half that matters most in practice: it records the upstream attribution
		    chain and Klei's no-commercial-use terms.
		    A mod's own preview.png needs no entry here: anything sitting at the root of its
		    ModAssets folder is already copied to the mod folder root by the glob below.-->
		<Copy
		  SourceFiles="$(MSBuildThisFileDirectory)LICENSE;$(MSBuildThisFileDirectory)NOTICE"
		  DestinationFolder="$(TargetFolder)"/>

		<Message Text="Copy ModAssets to $(TargetFolder)" Importance="High"/>

		<Copy SourceFiles="@(ModAssets)" DestinationFolder="$(TargetFolder)\%(RecursiveDir)" SkipUnchangedFiles="false" Condition="'$(OfflineBuild)' == 'true' Or '$(SkipAssetClone)' != 'true'"/>

		<Message Text="Copied build files" Importance="High" />

	</Target>

	<!--Creates publicized dlls from the game dlls (real-game builds only; offline builds use ./lib/*_public.dll)-->
	<ItemGroup>
		<PubliciseAssemblies       Include="Assembly-CSharp.dll;Assembly-CSharp-firstpass.dll;"/>
		<PubliciseAssembliesInputs Include="@(PubliciseAssemblies->'$(GameLibsFolder)/%(Filename)%(Extension)')"/>
	</ItemGroup>
	<Target Name="Publicise"
		BeforeTargets="BeforeResolveReferences"
		Inputs="@(PubliciseAssembliesInputs)"
		Outputs="@(PubliciseAssembliesInputs->'$(SolutionDir)PublicisedAssembly\%(Filename)_public%(Extension)')"
		Condition="'$(OfflineBuild)' != 'true' and '$(IsMod)' == 'true'"
		>

		<Message Text="Publicizing $(Inputs)" Importance="High"/>
		<MakeDir Directories="$(SolutionDir)/PublicisedAssembly"/>
		<Exec Command='dotnet tool run assembly-publicizer -o "$(SolutionDir)PublicisedAssembly/%(PubliciseAssembliesInputs.Filename)_public%(PubliciseAssembliesInputs.Extension)" "%(PubliciseAssembliesInputs.Identity)"' />
		<Touch Files="@(PubliciseAssembliesInputs->'$(SolutionDir)PublicisedAssembly\%(Filename)_public%(Extension)')" />
	</Target>
</Project>
